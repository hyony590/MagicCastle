{
  "name": "castle-climber-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:levels": "esbuild scripts/check-levels.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/check-levels.mjs && node node_modules/.cache/check-levels.mjs",
    "export:sprites": "esbuild scripts/export-sprites.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/export-sprites.mjs && node node_modules/.cache/export-sprites.mjs"
  },
  "dependencies": {
    "galmuri": "^2.40.3",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
